# ===== 阿里百炼 API =====
BASE_URL=https://dashscope.aliyuncs.com
LLM_MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL=qwen3-vl-embedding
RERANK_MODEL=qwen3-vl-rerank
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 并发控制 =====
LLM_CONCURRENCY=8
LLM_RPS=4
EMBED_CONCURRENCY=8
EMBED_BATCH_SIZE=10
RERANK_CONCURRENCY=4

# ===== 嵌入维度（按模型实际） =====
EMBED_DIM=1024

# ===== 数据库连接 =====
POSTGRES_DSN=postgresql://medgraph:medgraph_pwd@127.0.0.1:5432/medgraph
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medgraph_pwd
QDRANT_URL=http://127.0.0.1:6333

# ===== 集合命名 =====
QDRANT_COLLECTION_Q=medgraph_q
QDRANT_COLLECTION_A=medgraph_a
QDRANT_COLLECTION_TOPIC=medgraph_topic

# ===== 数据路径 =====
DATA_FILE=Professional.json
CACHE_DIR=data/cache

# ===== 检索参数 =====
RECALL_TOP_K_VECTOR=30
RECALL_TOP_K_GRAPH=20
RERANK_TOP_K=8
